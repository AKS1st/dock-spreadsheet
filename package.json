{
  "name": "dock-spreadsheet",
  "version": "0.1.0",
  "description": "Read-only XLSX, XLS, ODS, CSV and TSV viewer for the DSH dock workbench",
  "keywords": ["deepseek-harness", "dsh", "dock", "spreadsheet", "xlsx", "csv", "viewer"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKS1st/dock-spreadsheet.git"
  },
  "homepage": "https://github.com/AKS1st/dock-spreadsheet#readme",
  "bugs": "https://github.com/AKS1st/dock-spreadsheet/issues",
  "publishConfig": { "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "assets",
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node scripts/embed-css.mjs && tsc -p tsconfig.json --noEmit --pretty false",
    "build": "node scripts/embed-css.mjs && tsc -p tsconfig.json && tsdown -c tsdown.config.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "dock-base": ">=0.2.0",
    "dock-files": ">=0.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dock-base": {
      "optional": true
    },
    "dock-files": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "tabulator-tables": "^6.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "@types/tabulator-tables": "^6.3.6",
    "cordis": "^4.0.0-rc.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
